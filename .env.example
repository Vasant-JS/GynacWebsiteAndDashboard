PORT=5177

# Existing development bookings use demo payments. Set razorpay only after configuring all keys.
PAYMENT_PROVIDER=demo
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SESSION_SECRET=change-this-dev-secret

# Supabase/Postgres:
# Copy the Session Pooler URI from Supabase Dashboard > Connect.
# Use Session Pooler for local IPv4 development unless your network supports direct IPv6.
# Example:
# DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=femmecare

USE_PG_SESSION=true
SESSION_MAX_AGE_MS=604800000

# Google Calendar / Meet. Use an OAuth refresh token with Calendar event creation access.
# Set GOOGLE_CALENDAR_ACCESS_TOKEN for a short-lived token, or configure all three OAuth values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
APPOINTMENT_TIME_ZONE=Asia/Kolkata
BOOKING_NOTIFICATION_EMAIL=sumohancaretech@gmail.com

# Future WhatsApp integration
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
